# Pinned images and resource budgets for every study in this repository.
#
# Pinning matters twice over: a floating tag makes a result unreproducible, and
# it makes two results in this repo silently incomparable. Change a value here
# only together with a new run, and record the change in LESSONS_LEARNED.md.

PG_IMAGE="docker.io/library/postgres:17.11"
YB_IMAGE="docker.io/yugabytedb/yugabyte:2025.2.6.0-b111"
GO_IMAGE="docker.io/library/golang:1.26-bookworm"

BENCH_IMAGE="localhost/charitybench:1"
NETWORK="adsnet"

# ---------------------------------------------------------------------------
# Resource budget
#
# Held constant PER DATABASE NODE, not per cluster. A single-node engine and one
# node of a three-node cluster get exactly the same CPU and memory, so
# "single vs cluster" answers the question an operator actually asks: what do I
# get when I add two more machines? The alternative framing -- fixing the total
# cluster budget and splitting it three ways -- answers a different question and
# would need its own run.
#
# Limits are CFS quotas (--cpus), not core pins (--cpuset-cpus). See
# docs/environments/*.md: this host mixes performance and efficiency cores that
# the guest kernel cannot tell apart, so pinning would silently bias a container
# onto slow cores. A quota gives every container an equal share of whatever it
# lands on, and repeated trials expose the scheduling luck as variance.
# ---------------------------------------------------------------------------
DB_CPUS="2"
DB_MEMORY="3g"
CLIENT_CPUS="2"
CLIENT_MEMORY="2g"

# Host ports. Only needed for ad-hoc inspection; the benchmark client talks to
# the databases over the container network by name and does not use these.
PG_PORT="55432"
YB_PORT="55433"
YB_UI_PORT="57000"

# Cache engine for study 05 (external cache throughput and consistency).
# Appended, not modified: studies 01-04 never start Redis. Pinned to an exact tag
# (methodology 3); the image id is recorded in every run manifest and in the
# Redis capability probe.
REDIS_IMAGE="docker.io/library/redis:7.4.11-alpine"

# Tool image for the AI work queue (tools/queue). Built locally from
# tools/queue/Containerfile; the base is the same pinned Go toolchain every
# study builds with, so the queue CLI and its tests run in Podman with no host
# language toolchain. The image contains git, which the queue CLI drives.
QUEUE_IMAGE="localhost/ads-queue:1"

# Diagram renderer for every study's diagrams/render.sh. Pinned by manifest
# digest (not :latest) so two renders of the same .puml source are provably the
# same picture; matches the Typst toolchain's digest pinning. Tag for that digest:
# 1.2026.8 (PlantUML 1.2026.8 / 149874a, 2026-09-05). Referenced by
# infra/diagram-render.sh; the resolved digest is written beside each study's
# rendered output in its diagrams/RENDERER.md.
PLANTUML_IMAGE="docker.io/plantuml/plantuml@sha256:9b9ee6af54a86ea6ac53805e9da4da7fd913711cfe6c19b6ac1a41c398223aeb"
