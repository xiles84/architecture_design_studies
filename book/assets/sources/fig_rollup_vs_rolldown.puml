@startuml fig_rollup_vs_rolldown
!include _style.puml
' Book figure — the two opposite directions of derived parent/child state.
' Form: structure. Evidence status: conceptual illustration; asserts no rate.
title rolldown copies a parent value down; rollup aggregates child facts up
top to bottom direction
skinparam nodesep 16
skinparam ranksep 26

rectangle "ROLLDOWN — parent information copied down" as RD #FBF3E6 {
  rectangle "Donor.display_name" as RDP <<authoritative>>
  rectangle "Donation.donor_display_name" as RDC <<derived>>
  RDP --> RDC : copied down
}
note right of RDC
  One parent change fans out:
  Donor.display_name changes
  -> refresh Donation A
  -> refresh Donation B
  -> refresh Donation C
end note

rectangle "ROLLUP — child facts aggregated up" as RU #EAF3EC {
  rectangle "Donation.amount" as RUC <<authoritative>>
  rectangle "Donor.lifetime_total" as RUP <<derived>>
  RUC --> RUP : aggregated up
}
note right of RUP
  Each contributing child change
  maintains one parent aggregate:
  INSERT / UPDATE Donation
  -> maintain Donor.lifetime_total
end note
@enduml
