' Shared styling for the book's OWN figure sources (figures that belong to the
' book rather than to a study). Study figures keep their study's _style.puml.
' Included with: !include _style.puml
@startuml
skinparam shadowing false
skinparam defaultFontName "Segoe UI, Helvetica, Arial"
skinparam defaultFontSize 12
skinparam ArrowColor #5A6B7D
skinparam ArrowFontColor #5A6B7D
skinparam sequence {
  LifeLineBorderColor #5A6B7D
  ParticipantBorderColor #5A6B7D
  ParticipantBackgroundColor #E8EDF4
  ParticipantFontStyle bold
  ActorBorderColor #5A6B7D
  ActorBackgroundColor #FBFBF6
  ActorFontStyle bold
}
skinparam note {
  BackgroundColor #FBFBF6
  BorderColor #BDBDB0
  FontSize 11
}
skinparam rectangle {
  BackgroundColor #FBFBF6
  BorderColor #5A6B7D
  FontSize 11
}
' One visual language for ownership. Solid boxes are authoritative stored state;
' green boxes are derived state; amber, dashed boxes are non-authoritative copies
' outside the database. Solid arrows are synchronous, dashed arrows derived or
' asynchronous propagation, and every figure uses the same three stereotypes.
skinparam rectangle<<authoritative>> {
  BackgroundColor #E8EDF4
  BorderColor #2B4B8F
  BorderThickness 1.5
}
skinparam rectangle<<derived>> {
  BackgroundColor #EAF3EC
  BorderColor #1F6F4A
  BorderThickness 1.5
}
skinparam rectangle<<external>> {
  BackgroundColor #FBF3E6
  BorderColor #8A5A00
  BorderThickness 1.5
  BorderStyle dashed
}
skinparam class<<authoritative>> {
  BackgroundColor #E8EDF4
  BorderColor #2B4B8F
  BorderThickness 1.5
}
skinparam class<<derived>> {
  BackgroundColor #EAF3EC
  BorderColor #1F6F4A
  BorderThickness 1.5
}
skinparam class<<external>> {
  BackgroundColor #FBF3E6
  BorderColor #8A5A00
  BorderThickness 1.5
  BorderStyle dashed
}
@enduml
