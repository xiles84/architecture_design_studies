@startuml fig_topology_physical_boundary
!include _style.puml
' Book figure — the three logical topologies live inside one physical host, and physical
' placement is an instrument gap, not a measured fact.
' Form: structure. Evidence status: conceptual illustration; asserts no rate.
title three logical topologies inside one physical host
top to bottom direction
skinparam nodesep 16
skinparam ranksep 30

rectangle "ONE PHYSICAL HOST — one WSL2 machine, shared cores,\nloopback-class network, no real inter-host network" as HOST #FBFBF6 {
  rectangle "PostgreSQL\nsingle node" as PG <<authoritative>>
  rectangle "YugabyteDB RF=1\none logical node" as YB1 <<authoritative>>
  rectangle "YugabyteDB RF=3\nlogical node 1 · node 2 · node 3" as YB3 <<authoritative>>
}

rectangle "logical key -> expected tablet mapping\n(follows from a hash key: a configuration fact)" as L1 <<authoritative>>
rectangle "actual tablet / leader physical placement\nUNVERIFIED in this corpus" as L2 #FBEDED

L1 --> L2 : cannot be observed with this harness
@enduml
