# Book build image.
#
# The Typst toolchain is pinned by immutable manifest digest, so a rebuild on any
# machine gets byte-identical rendering behaviour. Typst ships its default fonts
# (Libertinus Serif, New Computer Modern, DejaVu Sans Mono) inside the binary, so
# the PDF embeds them with no host font installation; this image adds only the
# PDF-inspection tools the build verifies with.
#
# Build and compile through ../../book/build.sh — never on the host.

FROM ghcr.io/typst/typst@sha256:032e292249bcd378480cc7c142cfa324b63ef8aadeb88d7e7230320c4c9c422f

RUN apk add --no-cache poppler-utils file

WORKDIR /book
COPY . /book
ENTRYPOINT ["/bin/typst"]
