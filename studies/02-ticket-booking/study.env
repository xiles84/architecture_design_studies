# Study 02 settings shared by its scripts. Sourced after infra/versions.env.
#
# Each study builds its own benchmark image, so rebuilding one study's client
# can never change the binary another study's matrix is running.
STUDY_ID="02-ticket-booking"
BENCH_IMAGE="localhost/ticketbench:1"

# Real READ COMMITTED on YugabyteDB, pinned. The 2025.2.6 image already runs RC
# as RC without this flag (verified), but older releases fell back to Snapshot
# Isolation, and every design here that relies on RC's re-check-after-lock-wait
# semantics would then be measured under different rules than on PostgreSQL.
# The effective level is recorded in every result as engine_info.effective_isolation.
YB_EXTRA_TSERVER_FLAGS="yb_enable_read_committed_isolation=true"

# Harness flags added for YugabyteDB topologies only. Taking a hold on YugabyteDB
# here takes longer than PostgreSQL's 250 ms TTL, so at scale 1 almost every hold
# expired before payment and the experiment measured nothing. Scaling all hold
# timings by 10 keeps their ratios (and so the share of late payments) unchanged.
# Fewer, smaller hold events keep a cell within hours rather than days. Both are
# recorded in every result's options and shown in the report.
YB_HARNESS_FLAGS="-hold-time-scale 10 -hold-tiers 10,100 -hold-events-per-tier 4"
