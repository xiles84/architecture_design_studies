# Benchmark client for study 05 (external cache throughput and consistency).
#
# Build context is the REPOSITORY ROOT, not this directory, because the harness
# depends on the shared platform module (platform/) through a replace directive.
# run-study.sh passes the right context; .containerignore at the root keeps results
# and git history out of it.
#
# The SQL catalogue is compiled into the binary via go:embed, so a result can never
# be produced by a binary running SQL that differs from the SQL beside it.
#
# Tests run in the build stage, and so does the platform's own test suite. Study 05
# puts its most consequential logic in unit tests -- exact LRU eviction, the 300 s
# hard TTL, the probabilistic early-expiry draw at five fixed ages, lease
# acquisition/expiry/compare-and-delete release, version fencing, the canonical
# content hash, and the oracle's freshness classification -- because each of those
# decides whether a number is a measurement or a confident mistake. An image whose
# tests fail must not exist.

FROM docker.io/library/golang:1.26-bookworm AS build
WORKDIR /src

COPY platform/go.mod platform/go.sum ./platform/
COPY studies/05-cache-consistency/go.mod studies/05-cache-consistency/go.sum ./studies/05-cache-consistency/
RUN cd studies/05-cache-consistency && go mod download

COPY platform/ ./platform/
COPY studies/05-cache-consistency/sqlfs.go ./studies/05-cache-consistency/
COPY studies/05-cache-consistency/sql/ ./studies/05-cache-consistency/sql/
COPY studies/05-cache-consistency/harness/ ./studies/05-cache-consistency/harness/

# The platform's tests gate the image as well: a study must not ship on a platform
# that fails its own tests.
RUN cd platform && go vet ./... && go test ./...
RUN cd studies/05-cache-consistency && go vet ./... && go test ./... && \
    CGO_ENABLED=0 GOFLAGS=-trimpath go build -ldflags="-s -w" -o /out/bench ./harness

FROM scratch
COPY --from=build /out/bench /bench
WORKDIR /results
ENTRYPOINT ["/bench"]
