# Study 05 settings shared by its scripts. Sourced after infra/versions.env.
#
# Each study builds its own benchmark image, so rebuilding one study's client can
# never change the binary another study's matrix is running.
STUDY_ID="05-cache-consistency"
BENCH_IMAGE="localhost/cachebench:1"

# The cache engine under test is pinned in infra/versions.env (REDIS_IMAGE).
# Nothing but Study 05 starts a Redis container, so its name and volume are
# study-scoped by design: a second agent's study can run its own database
# container without colliding with this one, and the benchmark lock still
# serialises the measurements.
REDIS_NAME="ads-redis"
REDIS_VOLUME="ads-redis-data"

# Real READ COMMITTED on YugabyteDB, pinned exactly as in studies 02, 03 and 04.
# The owned model's optimistic guard re-checks its row after a lock wait, and its
# pessimistic path takes a row lock before reading -- both are READ COMMITTED
# behaviour, and the effective level is recorded in every result as
# engine_info.effective_isolation.
YB_EXTRA_TSERVER_FLAGS="yb_enable_read_committed_isolation=true"

# PostgreSQL runs every harness default. The scale, phase list, TTL, lease and
# capacity knobs are harness flags, not engine-specific ones.
PG_HARNESS_FLAGS=""

# YugabyteDB statements take longer on this laptop (studies 02-04 all hit this).
# Study 05 keeps the same measurement shape on both engines and bounds the number
# of cells per engine instead of rescaling the workload, so nothing is scaled
# here; a phase-C calibration decides whether a per-engine bound is needed, and
# any addition is recorded in every result's options.
YB_HARNESS_FLAGS=""

# Designs whose SQL uses YugabyteDB-only syntax. The runner never schedules them
# on PostgreSQL and the report marks them n/a there. The colocation pair is the
# non-colocated half of the placement experiment: its DDL is the same schema
# without the colocation clause, so it cannot run on PostgreSQL as written.
YB_ONLY_DESIGNS="y1_colocated y2_noncolocated"
