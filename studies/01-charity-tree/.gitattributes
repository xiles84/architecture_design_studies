# Result digests hash bytes. Preserve the container-written LF bytes when these
# new v3 runs are checked out on Windows with core.autocrlf=true. Historical runs
# retain their existing checkout policy; changing their bytes needs its own audit.
results/*-v3/**/*.json text eol=lf
results/devchecks/**/*.json text eol=lf
run-select.sh text eol=lf
selectbench/sql/*.sql text eol=lf
results/select-*-check-*/**/*.json text eol=lf
# Preserve terminal control bytes and spaces in the unfiltered engine log.
results/select-*-check-*/resources/database.log -text -diff
