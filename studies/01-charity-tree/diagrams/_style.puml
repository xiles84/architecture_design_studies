' Shared styling for every schema diagram in this study.
' Included with: !include _style.puml
@startuml
!$C_BASE     = "#FFFFFF"
!$C_HEADER   = "#E8EDF4"
!$C_DENORM   = "#FFF3CD"
!$C_ROLLUP   = "#D8F0DE"
!$C_EMBED    = "#E7DDF5"
!$C_LINE     = "#5A6B7D"

hide circle
hide empty members
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName "Segoe UI, Helvetica, Arial"
skinparam defaultFontSize 12
skinparam ArrowColor $C_LINE
skinparam ArrowFontColor $C_LINE
skinparam class {
  BorderColor $C_LINE
  BackgroundColor $C_BASE
  HeaderBackgroundColor $C_HEADER
  AttributeFontSize 11
}
skinparam note {
  BackgroundColor #FBFBF6
  BorderColor #BDBDB0
  FontSize 11
}
skinparam legend {
  BackgroundColor #FBFBF6
  BorderColor #BDBDB0
  FontSize 11
}
@enduml
