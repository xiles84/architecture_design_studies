# Study 03 settings shared by its scripts. Sourced after infra/versions.env.
#
# Each study builds its own benchmark image, so rebuilding one study's client
# can never change the binary another study's matrix is running.
STUDY_ID="03-reserved-seating"
BENCH_IMAGE="localhost/seatbench:1"

# Real READ COMMITTED on YugabyteDB, pinned exactly as in study 02. Designs S1,
# S2, E1, K1 and L3 rely on a conditional UPDATE re-checking its row after a lock
# wait; that is READ COMMITTED behaviour, and the effective level is recorded in
# every result as engine_info.effective_isolation.
YB_EXTRA_TSERVER_FLAGS="yb_enable_read_committed_isolation=true"

# PostgreSQL runs every harness default: one human minute of the lifecycle
# experiment lasts 50 ms (a 40-minute hold lasts 2 s). Calibrated in the dev
# checks: see PROGRESS.md.
PG_HARNESS_FLAGS=""

# YugabyteDB statements take longer than PostgreSQL's here (study 02: a hold took
# longer than a 250 ms TTL), so one human minute lasts 500 ms. Scaling every
# lifecycle duration by the same factor keeps their ratios, and so the share of
# payments that straddle an expiry, unchanged. Fewer, smaller lifecycle events
# keep a cell within hours. Recorded in every result's options.
#
# HANDOFF AM-02 rule 1 (dc15 calibration): the 100 000-seat race event timed out with 2% (yb-single)
# and 3% (yb-cluster3) of its seats sold, under the 25% threshold, so that race tier is not run on
# YugabyteDB. The 10 000-seat tier (69-73% sold) remains. PostgreSQL keeps every tier.
YB_HARNESS_FLAGS="-human-minute 500ms -lifecycle-tiers 10,100 -lifecycle-events-per-tier 3 -race-tiers 10,100,1000,10000"

# Designs whose SQL uses YugabyteDB-only syntax. The runner never schedules them
# on PostgreSQL, and the report marks them n/a there.
YB_ONLY_DESIGNS="l3_section_sharded"
