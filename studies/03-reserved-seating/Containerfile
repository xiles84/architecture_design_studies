# Benchmark client for study 03.
#
# Build context is the REPOSITORY ROOT, not this directory, because the harness
# depends on the shared platform module (platform/) through a replace directive.
# run-study.sh passes the right context; .containerignore at the root keeps
# results and git history out of it.
#
# The SQL catalogue is compiled into the binary via go:embed, so a result can
# never be produced by a binary running SQL that differs from the SQL beside it.
#
# Unit tests run in the build stage: the ledger decides whether a design broke an
# invariant, so an image whose ledger tests fail must not exist.

FROM docker.io/library/golang:1.26-bookworm AS build
WORKDIR /src

COPY platform/go.mod platform/go.sum ./platform/
COPY studies/03-reserved-seating/go.mod studies/03-reserved-seating/go.sum ./studies/03-reserved-seating/
RUN cd studies/03-reserved-seating && go mod download

COPY platform/ ./platform/
COPY studies/03-reserved-seating/sqlfs.go ./studies/03-reserved-seating/
COPY studies/03-reserved-seating/sql/ ./studies/03-reserved-seating/sql/
COPY studies/03-reserved-seating/harness/ ./studies/03-reserved-seating/harness/

RUN cd studies/03-reserved-seating && go vet ./... && go test ./... && \
    CGO_ENABLED=0 GOFLAGS=-trimpath go build -ldflags="-s -w" -o /out/bench ./harness

FROM scratch
COPY --from=build /out/bench /bench
WORKDIR /results
ENTRYPOINT ["/bench"]
