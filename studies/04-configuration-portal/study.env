# Study 04 settings shared by its scripts. Sourced after infra/versions.env.
#
# Each study builds its own benchmark image, so rebuilding one study's client can
# never change the binary another study's matrix is running.
STUDY_ID="04-configuration-portal"
BENCH_IMAGE="localhost/configbench:1"

# Real READ COMMITTED on YugabyteDB, pinned exactly as in studies 02 and 03. The
# designs c1 (optimistic version check) and c2 (lock before update) both rely on
# a conditional UPDATE re-checking its row after a lock wait; that is READ
# COMMITTED behaviour, and the effective level is recorded in every result as
# engine_info.effective_isolation.
YB_EXTRA_TSERVER_FLAGS="yb_enable_read_committed_isolation=true"

# PostgreSQL runs every harness default. The cardinality, cadence and contention
# phases are driven by harness flags, not by engine-specific ones.
PG_HARNESS_FLAGS=""

# YugabyteDB statements take longer on this laptop (studies 02 and 03 both hit
# this: a hold that took 250 ms on PostgreSQL took longer than a 250 ms TTL on
# YugabyteDB). Study 04 keeps the same measurement shape on both engines and
# instead bounds the number of events per cell, so nothing is scaled here yet;
# a calibration in phase C decides whether a per-engine bound is needed, and any
# addition is recorded in every result's options.
YB_HARNESS_FLAGS=""

# Designs whose SQL uses YugabyteDB-only syntax. The runner never schedules them
# on PostgreSQL and the report marks them n/a there. y2 is the non-colocated half
# of the colocation pair: its DDL is the same schema without the colocation
# clause, so it cannot run on PostgreSQL as written.
YB_ONLY_DESIGNS="y1_colocated y2_noncolocated"
